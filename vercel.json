{
  "version": 2,
  "builds": [
    { "src": "api/chat.py", "use": "@vercel/python" },
    { "src": "api/audio.py", "use": "@vercel/python" },
    { "src": "api/docs.py", "use": "@vercel/python" },
    { "src": "api/vision.py", "use": "@vercel/python" }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ]
}